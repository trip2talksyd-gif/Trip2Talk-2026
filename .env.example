VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Daily cron (Phases G/H) — set the SAME value in Vercel env + Supabase Edge secret CRON_SECRET
# Vercel Cron hits /api/cron/daily once per day (Hobby-safe).
# Proxy uses VITE_SUPABASE_ANON_KEY (or SUPABASE_ANON_KEY) for gateway JWT;
# CRON_SECRET is passed as ?secret= to cron-daily (not in Authorization).
CRON_SECRET=

# =============================================================================
# Anthropic — Quick Post / generate-caption + generate-trip-post Edge Functions
# =============================================================================
# Set the SAME value as a Supabase Edge Function secret (Dashboard → Edge Functions → Secrets).
# Without this, /app/quick-post uploads the photo then fails at AI caption with
# missing_anthropic_api_key.
ANTHROPIC_API_KEY=

# =============================================================================
# Meta Graph API v20.0 — Page credentials (set same keys in Supabase Edge secrets)
# =============================================================================
# target_account = trip2talk_page  → uses *_TRIP2TALK
# target_account = chapter99_page  → uses FACEBOOK_PAGE_ID + FACEBOOK_PAGE_ACCESS_TOKEN
# target_account = group_thaiaus   → NO Graph (manual UI only); group id below
#
# NEVER commit real tokens. Put them in .env.local / Supabase secrets only.

# --- Trip2Talk Page (name: Trip2Talk) ---
# Page ID: ตัวเลขล้วน จาก Graph API Explorer หรือ Page → About
# ACCESS TOKEN must be a long-lived PAGE token (not a User token).
# In Graph API Explorer: get User token with pages_show_list + pages_manage_posts,
# then GET /me/accounts and copy that Page's access_token into this secret.
FACEBOOK_PAGE_ID_TRIP2TALK=
FACEBOOK_PAGE_ACCESS_TOKEN_TRIP2TALK=
# aliases also accepted by staff-api:
# FB_PAGE_ID_TRIP2TALK=
# FB_PAGE_ACCESS_TOKEN_TRIP2TALK=

# --- Chapter99 Page (name: Chapter99) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# aliases:
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=

# --- Thai Aus Admin Page (optional — for admin/tools; group posts stay manual) ---
# Page name: Thai Aus Admin
FACEBOOK_PAGE_ID_THAIAUS_ADMIN=
FACEBOOK_PAGE_ACCESS_TOKEN_THAIAUS_ADMIN=

# Thai-Aus Verified Community group (manual post target)
FACEBOOK_GROUP_ID_THAIAUS=1631889741218502

FB_API_VERSION=v20.0
# true = dry-run Graph · false = live publish
MOCK_FACEBOOK=true
